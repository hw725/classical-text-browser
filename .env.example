# ===================================
# 고전 텍스트 디지털 서고 — 환경 설정
# ===================================
# 사용법:
#   1. 이 파일을 같은 위치에서 .env 로 복사합니다.
#   2. 아래에서 필요한 값만 주석(#)을 해제하고 채우세요.
#
# .env 파일 위치 (두 곳 모두 가능):
#   - 프로젝트 루트 (.env.example과 같은 폴더) ← API 키는 여기 권장
#   - 서고 루트 (library_root/)               ← 서고별 설정 덮어쓰기용
#
# 설정 우선순위: 시스템 환경변수 → 서고 .env → 프로젝트 루트 .env → 기본값

# --- LLM 설정 (Phase 10-2) ---

# Ollama URL (1순위 폴백)
# Ollama를 설치하고 `ollama serve`로 실행하면 자동 감지됩니다.
# OLLAMA_URL=http://localhost:11434

# Ollama가 이미지 인식(OCR)에 쓸 모델.
# 비워 두면 설치된 비전 모델 중 클라우드를 우선해 자동으로 고릅니다.
#
# 왜 이 설정이 있는가: 지정한 모델이 설치돼 있지 않으면 호출이 조용히 실패하고
# 다음 프로바이더(유료 API)로 넘어갑니다. 무엇이 도는지 모른 채 과금되는 일을
# 막으려면 여기서 못 박아 두는 것이 확실합니다.
#   qwen3.5:cloud  → ollama.com 구독 한도를 씁니다 (금액 청구는 없음)
#   qwen3.5:4b     → 로컬 실행, 비용·한도 소모 없음 (다만 사양을 탑니다)
# 설치 확인: ollama list
# OLLAMA_VISION_MODEL=qwen3.5:cloud

# --- PaddleOCR 설정 ---

# PaddleOCR 언어 모델. 비워 두면 ch(중국어 간체)입니다.
#
# 주의: PaddleOCR는 한글과 한자를 **동시에 읽지 못합니다.**
#   korean       → 한글만 (한자 0자)
#   chinese_cht  → 한자만 (한글 0자)
# 그래서 이 저장소는 인식을 LLM Vision에 맡기고 PaddleOCR는 **줄 위치 검출**에
# 씁니다. 이 값은 `--engine paddleocr`로 인식까지 시킬 때만 의미가 있습니다.
# CTB_PADDLE_LANG=korean

# PaddleOCR 연산 장치: auto | cpu | gpu
#
# auto(기본)는 설치된 paddle이 CUDA 빌드이고 장치가 실제로 보일 때만 GPU를
# 고릅니다. GPU가 없으면 아무것도 하지 않아도 CPU로 갑니다.
# GPU가 있는데 CPU로 재보고 싶을 때 cpu로 못 박습니다.
# GPU판으로 바꾸는 절차: docs/user-guide.md 「PaddleOCR를 GPU로 돌리기」
# CTB_PADDLE_DEVICE=auto

# OpenAI OAuth 프록시 URL (2순위 폴백, 선택)
# Windows start_server.bat는 npx.cmd가 있으면 openai-oauth 프록시를 자동 실행합니다.
# 직접 실행한 프록시 포트를 고정해야 할 때만 지정하세요.
# OPENAI_OAUTH_BASE_URL=http://127.0.0.1:10532/v1

# Google Gemini API 키 (3순위 폴백, 저렴)
# https://aistudio.google.com/apikey 에서 발급
# GOOGLE_API_KEY=...

# OpenAI API 키 (4순위 폴백, 중간)
# https://platform.openai.com/api-keys 에서 발급
# OPENAI_API_KEY=sk-...

# Anthropic API 키 (5순위 폴백, 최후)
# https://console.anthropic.com/ 에서 발급
# ANTHROPIC_API_KEY=sk-ant-...

# 월간 예산 (USD). 유료 API 비용 추적용.
# MONTHLY_BUDGET_USD=10.0

# --- 외부 표점 서비스 (SikuRoBERTa) ---

# 본체는 기본적으로 http://127.0.0.1:8765 의 로컬 표점 서비스를 사용합니다.
# 기본 연동을 끄려면 아래처럼 설정하세요.
# EXTERNAL_PUNCT_URL=off

# 다른 호스트/포트의 표점 서비스를 쓸 때만 덮어씁니다.
# EXTERNAL_PUNCT_URL=http://127.0.0.1:8765

# start_server.bat / start_server.sh 는 punctuation-service/.env 또는 시스템 환경변수
# PUNCT_MODEL_HOST_PATH가 있으면 Docker Compose로 표점 서비스를 자동 시작합니다.
# punctuation-service/.env 예:
# PUNCT_MODEL_HOST_PATH=C:/Users/<USER>/Downloads/classical-text-browser-models/punctuation/v2.5_best_model_9110/v2.5_best_model_9110/punct-epoch=03-val_f1=0.9110.ckpt
# 배치파일 자동 기동만 끄려면 실행 전 셸/시스템 환경변수로 PUNCT_AUTO_START=0을 설정합니다.

# --- OCR 설정 (Phase 10-1) ---

# 기본 OCR 엔진 (paddleocr | 향후 추가 엔진)
# PaddleOCR가 설치되어 있으면 자동 감지됩니다.
# OCR_DEFAULT_ENGINE=paddleocr

# 기본 인식 언어
# OCR_DEFAULT_LANGUAGE=classical_chinese

# 기본 쓰기 방향 (vertical_rtl | horizontal_ltr)
# OCR_DEFAULT_WRITING_DIRECTION=vertical_rtl

# --- KORCIS 설정 (Phase 10-4) ---

# 한국고문헌종합목록 (KORCIS) OpenAPI 키 (선택)
# 현재 KORCIS OpenAPI는 키 없이도 동작하지만,
# 공공데이터포털 경유 시 키가 필요할 수 있습니다.
# 발급: https://www.data.go.kr/ 에서 "국립중앙도서관" 검색
# NL_API_KEY=your_key_here
