{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boundaries.schema.json",
  "title": "Boundaries — 권 하나의 글 단위 경계 목록 (D-092)",
  "description": "단위(글)의 정본. 항목 하나가 «여기서 단위가 시작한다»이며, 끝은 저장하지 않고 같은 층위 이상의 다음 경계 앞까지로 정한다. 단위의 id는 시작 경계에 붙는다 — 관계·태그·L5~L7의 tb:UUID가 이 id를 가리킨다. 본문은 저장하지 않고 L4에서 잘라 온다(교감 자동 반영).",
  "type": "object",
  "required": ["document_id", "part_id", "boundaries"],
  "additionalProperties": false,
  "properties": {
    "document_id": { "type": "string", "description": "원본 문헌 ID." },
    "part_id": { "type": "string", "description": "권 ID." },
    "boundaries": {
      "type": "array",
      "description": "원본 위치 순서. 같은 자리면 층위가 얕은 것이 먼저.",
      "items": { "$ref": "#/$defs/Boundary" }
    }
  },
  "$defs": {
    "Position": {
      "type": "object",
      "required": ["page", "line", "offset"],
      "additionalProperties": false,
      "properties": {
        "page": { "type": "integer", "minimum": 1, "description": "쪽 번호(1부터)." },
        "line": { "type": "integer", "minimum": 0, "description": "L4 확정본의 행(0부터, 빈 행 포함)." },
        "offset": { "type": "integer", "minimum": 0, "description": "행 안의 글자 오프셋(0 = 행 첫머리)." }
      }
    },
    "Boundary": {
      "type": "object",
      "required": ["id", "level", "start", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "단위의 id(UUID). TextBlock에서 옮겨 온 것은 그 id를 그대로 물려받는다." },
        "level": { "type": "integer", "minimum": 1, "description": "층위. 1 = 卷·편, 2 = 기사(글), 3 이상 = 기사 안 조각(문답·협주·연)." },
        "start": { "$ref": "#/$defs/Position" },
        "title": { "type": ["string", "null"], "default": null, "description": "표제(목차·제안·사람이 적은 것)." },
        "kind": { "type": ["string", "null"], "default": null, "description": "종류: toc·date·표제 어휘·manual·front·volume 등." },
        "status": {
          "type": "string",
          "enum": ["draft", "active", "deprecated", "archived"],
          "description": "단위 상태(operation-rules 2.4의 전이 규칙을 따른다). deprecated·archived는 목록에 남되 단위를 만들지 않는다."
        },
        "anchor_status": {
          "type": ["string", "null"],
          "enum": ["proposed", "approved", "stale", null],
          "default": null,
          "description": "위치의 신뢰: 제안됨·승인됨·L4가 바뀐 뒤 못 찾음(stale — 사람이 옮겨야 한다)."
        },
        "work_id": { "type": ["string", "null"], "default": null, "description": "소속 Work의 id." },
        "anchor_text": { "type": ["string", "null"], "default": null, "description": "start 자리의 글자 몇 자. L4 커밋이 바뀌면 오프셋 대신 이것으로 자리를 다시 찾는다." },
        "l4_commit": { "type": ["string", "null"], "default": null, "description": "start가 어느 확정본 기준인지." },
        "confidence": { "type": ["number", "null"], "default": null },
        "reasons": { "type": "array", "items": { "type": "string" }, "default": [] },
        "bbox": {
          "type": ["object", "null"],
          "default": null,
          "description": "start 행의 L2 좌표 캐시 {start_line, image_width, image_height} — 화면 표시용. 정본이 아니다.",
          "additionalProperties": true
        },
        "notes": { "type": ["string", "null"], "default": null },
        "metadata": { "type": ["object", "null"], "default": null, "additionalProperties": true }
      }
    }
  }
}
