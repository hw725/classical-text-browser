{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boundary.schema.json",
  "title": "경계 색인 항목 (Boundary)",
  "description": "글 단위 경계의 정본 (D-090). «어디서 글이 시작하고 끝나는가»를 원본 저장소의 위치(권·쪽·행, 선택적으로 글자 오프셋)로 기록한다. TextBlock은 이 항목에서 파생된다 — 확정본(L4)이 바뀌면 이 앵커를 다시 대조해 TextBlock을 다시 잇는다. 쪽 번호가 아니라 «정확도 높은 자리»를 색인한다.",
  "type": "object",
  "required": ["id", "work_id", "document_id", "part_id", "order", "title", "kind", "status", "start", "end"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "work_id": { "type": "string" },
    "document_id": { "type": "string" },
    "part_id": { "type": "string" },
    "order": { "type": "integer", "minimum": 0, "description": "권 안에서의 순서." },
    "title": { "type": "string", "description": "경계 행의 표제(원문 그대로)." },
    "kind": { "type": "string", "description": "경계의 종류·근거: toc | date | title_word | manual | front | volume | 문헌 어휘." },
    "level": { "type": "integer", "minimum": 1, "maximum": 3, "default": 2, "description": "1=卷·篇 같은 상위, 2=글." },
    "status": { "type": "string", "enum": ["proposed", "approved", "manual", "deprecated"] },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "reasons": { "type": "array", "items": { "type": "string" }, "default": [] },
    "start": { "$ref": "#/$defs/Anchor" },
    "end": { "$ref": "#/$defs/Anchor", "description": "포함(inclusive) 끝 행." },
    "bbox": {
      "description": "L2 행 좌표로 환산한 위치. 재계산 가능하므로 캐시다.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start_line": { "type": ["array", "null"], "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
            "end_line": { "type": ["array", "null"], "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
            "image_width": { "type": ["integer", "null"] },
            "image_height": { "type": ["integer", "null"] }
          }
        }
      ],
      "default": null
    },
    "text_block_id": { "type": ["string", "null"], "default": null },
    "l4_commit": { "type": ["string", "null"], "description": "앵커가 가리키는 확정본의 원본 저장소 커밋.", "default": null },
    "metadata": { "type": ["object", "null"], "default": null }
  },
  "$defs": {
    "Anchor": {
      "type": "object",
      "required": ["page", "line"],
      "additionalProperties": false,
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "line": { "type": "integer", "minimum": 0, "description": "그 쪽 확정 텍스트의 행 번호(0-based, 빈 행 포함)." },
        "char": { "type": ["integer", "null"], "minimum": 0, "description": "행 안 글자 오프셋. 지금은 선택(D-090 1단계는 행 단위)." }
      }
    }
  }
}
